# Public URL used for OAuth callbacks and payment notifications
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth
AUTH_TRUST_HOST=true
AUTH_SECRET=replace_with_a_random_secret_string

# Linux DO Connect OAuth
OAUTH_CLIENT_ID=replace_with_client_id
OAUTH_CLIENT_SECRET=replace_with_client_secret

# EPay payment
MERCHANT_ID=replace_with_merchant_id
MERCHANT_KEY=replace_with_merchant_key
PAY_URL=https://credit.linux.do/epay/pay/submit.php

# Admin usernames, separated by commas
ADMIN_USERS=admin

# Database mode: sqlite (default) or mysql
DB_TYPE=sqlite

# SQLite database (used when DB_TYPE=sqlite)
DATABASE_PATH=./data/ldc-shop.sqlite

# MySQL connection (used when DB_TYPE=mysql)
# MySQL must be provided separately; use a host reachable from the app container
# DATABASE_URL=mysql://ldc_shop:change_me@192.168.1.100:3306/ldc_shop

# Optional GitHub OAuth
# GITHUB_ID=replace_with_github_client_id
# GITHUB_SECRET=replace_with_github_client_secret
