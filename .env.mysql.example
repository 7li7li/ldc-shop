# Copy this file to .env when using MySQL:
#   cp .env.mysql.example .env
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=replace_with_a_random_secret_string
OAUTH_CLIENT_ID=replace_with_client_id
OAUTH_CLIENT_SECRET=replace_with_client_secret
MERCHANT_ID=replace_with_merchant_id
MERCHANT_KEY=replace_with_merchant_key
PAY_URL=https://credit.linux.do/epay/pay/submit.php
ADMIN_USERS=admin

DB_TYPE=mysql
# Use an IP/DNS name reachable from the app container.
DATABASE_URL=mysql://ldc_shop:change_me@mysql-host:3306/ldc_shop
# For a MySQL container on 1Panel's network, uncomment the compose network
# and use its network alias as the host, for example:
# DATABASE_URL=mysql://ldc_shop:change_me@1Panel-mysql-9sgb:3306/ldc_shop

# Optional GitHub OAuth
# GITHUB_ID=replace_with_github_client_id
# GITHUB_SECRET=replace_with_github_client_secret
